classDiagram
    class Owner {
        +str name
        +int available_time_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) void
        +mark_task_complete(task: Task, current_date: date) Task
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str frequency
        +str time
        +date due_date
        +bool is_completed
        +str pet_name
        +mark_complete(current_date: date) Task
        +is_high_priority() bool
    }

    class Scheduler {
        +int time_limit_minutes
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +list~str~ reasoning
        +list~str~ conflict_warnings
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(tasks: list~Task~, completed: bool, pet_name: str) list~Task~
        +detect_conflicts(tasks: list~Task~) list~str~
        +schedule_for_owner(owner: Owner, time_limit_minutes: int) list~Task~
        +generate_plan(tasks: list~Task~, time_limit_minutes: int) list~Task~
        +get_summary() str
    }

    Owner "1" *-- "many" Pet : manages
    Pet "1" *-- "many" Task : has
    Scheduler ..> Owner : reads tasks from
    Scheduler ..> Task : schedules and filters
